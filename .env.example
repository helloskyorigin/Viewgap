# GROQ_API_KEY: Required for Groq AI API calls (production AI provider).
# Configure this secret via the AI Studio Secrets panel.
# Never expose this key in client-side code, logs, or repository commits.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Optional/legacy fallback key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server-Side Resource Limits, Timeouts & Safety Guards
WEBSITE_FETCH_TIMEOUT_MS=10000
WEBSITE_MAX_RESPONSE_BYTES=5000000
WEBSITE_MAX_REDIRECTS=5
WEBSITE_MAX_HTML_CHARS=200000
PLAYWRIGHT_TIMEOUT_MS=20000
PLAYWRIGHT_MAX_PAGE_SIZE_BYTES=5000000
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_MAX_INPUT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=3000
ANALYSIS_TOTAL_TIMEOUT_MS=90000
CHECK_RATE_LIMIT_PER_MINUTE=15
CHECK_MAX_CONCURRENT_PER_IP=2
VERIFY_RATE_LIMIT_PER_MINUTE=30
VERIFY_MAX_CONCURRENT_PER_IP=4

# Multi-Page Expansion (Supporting-Page Discovery, Fetching & Context Analysis)
# Feature flag defaults to false (OFF) until explicitly enabled in staging/production.
ENABLE_SUPPORTING_PAGES_ANALYSIS=false
SUPPORTING_PAGES_MAX_COUNT=3
SUPPORTING_PAGE_FETCH_TIMEOUT_MS=5000
SUPPORTING_PAGES_TOTAL_TIMEOUT_MS=8000
SUPPORTING_PAGE_MAX_RESPONSE_BYTES=2000000
SUPPORTING_PAGE_MAX_REDIRECTS=3
SUPPORTING_PAGE_MAX_HTML_CHARS=120000
SUPPORTING_PAGES_CONCURRENCY=3
SUPPORTING_CONTEXT_AI_TIMEOUT_MS=12000
SUPPORTING_CONTEXT_MAX_INPUT_CHARS=4500

# Legal & Customer Support Configuration
NEXT_PUBLIC_SUPPORT_EMAIL="hello.skyorigin@gmail.com"


